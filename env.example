# Fetch every N hours (preferred; takes precedence over FETCH_SCHEDULE_HOURS)
FETCH_INTERVAL_HOURS=3

# Or use specific hours (comma-separated). Only used if FETCH_INTERVAL_HOURS is unset.
# FETCH_SCHEDULE_HOURS=9,12,15,18,21

# Max pages to fetch per source per run
FETCH_MAX_PAGES=10

# Comma-separated ward codes to search.
# 新宿=13104, 渋谷=13113, 中野=13114
FETCH_WARD_CODES=13104,13113,13114

# Show properties seen within this many days
MAX_AGE_DAYS=30

# SQLite path (use absolute path inside container)
DB_PATH=/app/data/rental.db

# Server port
PORT=8080
