# Fetch every N minutes (preferred; takes precedence over FETCH_SCHEDULE_HOURS)
# Legacy FETCH_INTERVAL_HOURS=N is still honored as a fallback.
FETCH_INTERVAL_MINUTES=30

# Or use specific hours (comma-separated). Only used if FETCH_INTERVAL_* is unset.
# FETCH_SCHEDULE_HOURS=9,12,15,18,21

# Max pages to fetch per source per run
FETCH_MAX_PAGES=10

# Ward codes. This deployment is hard-locked to 新宿 / 渋谷 / 中野 in code,
# requests outside this list are ignored at the orchestrator level.
# 新宿=13104, 渋谷=13113, 中野=13114
FETCH_WARD_CODES=13104,13113,13114,13115

# Show properties seen within this many days
MAX_AGE_DAYS=30

# SQLite path (use absolute path inside container)
DB_PATH=/app/data/rental.db

# Server port
PORT=8080
